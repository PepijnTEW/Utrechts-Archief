{
  "name": "peptho-bismol/info_points",
  "description": "custom REST API info points",
  "type": "project",
  "require": {
    "php": "^8.5.10",
    "ext-json": "*",
    "ext-pdo": "*",
    "firebase/php-jwt": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
